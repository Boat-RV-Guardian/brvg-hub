# BRVG phone-home agent — systemd unit for Pi-class hubs.
# Install: copy brvg-agent.sh to /usr/local/bin/brvg-agent (chmod 755), config to
# /etc/brvg-agent.conf (chmod 600), this file to /etc/systemd/system/, then:
#   systemctl enable --now brvg-agent

[Unit]
Description=BRVG phone-home agent (GPS + modem telemetry)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/brvg-agent
Restart=always
RestartSec=30
# Telemetry pusher needs nothing but the serial devices and outbound HTTPS.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
