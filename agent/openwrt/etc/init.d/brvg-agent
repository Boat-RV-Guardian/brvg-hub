#!/bin/sh /etc/rc.common
# BRVG phone-home agent — OpenWrt/GL.iNet procd service.
# Install: copy brvg-agent.sh to /usr/bin/brvg-agent (chmod 755), config to /etc/brvg-agent.conf
# (chmod 600), this file to /etc/init.d/brvg-agent (chmod 755), then:
#   /etc/init.d/brvg-agent enable && /etc/init.d/brvg-agent start

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/brvg-agent
    procd_set_param respawn 3600 30 0   # retry forever, 30 s apart, reset counter hourly
    procd_set_param stderr 1            # agent logs go to logread
    procd_close_instance

    # Relay tier (HUB-PROXY.md): a dedicated uhttpd serves the CGI webhook receiver. Only when the
    # config asks for it AND uhttpd exists — the agent itself must keep working without either.
    # shellcheck disable=SC1091
    [ -f /etc/brvg-agent.conf ] && . /etc/brvg-agent.conf
    if [ "${RELAY_ENABLED:-0}" = "1" ] && [ -x /usr/sbin/uhttpd ] && [ -d /www/brvg ]; then
        procd_open_instance relay
        procd_set_param command /usr/sbin/uhttpd -f -h /www/brvg -x /cgi-bin -p "0.0.0.0:${RELAY_PORT:-8181}"
        procd_set_param respawn 3600 30 0
        procd_close_instance
    fi
}
