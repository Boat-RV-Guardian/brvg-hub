#!/bin/sh
# Load (or reload) the daemon right away — an installer that leaves the service dead until reboot
# reads as a broken install. bootout first so an upgrade over a running hub swaps binaries cleanly.
launchctl bootout system/com.sc4tech.brvg-hub 2>/dev/null || true

# ⚠️ THE EXIT CODE IS THE WHOLE POINT OF THIS BLOCK. This script previously ran bootstrap and then
# `exit 0` unconditionally, so a FAILED bootstrap still presented as a clean install: Installer.app
# showed success, the app's Hub Service screen was told the service was installed, and the hub was
# not running. The failure then surfaced much later as "registered but never heartbeats", which is
# an expensive thing to debug from the app side because every visible signal says the install worked.
if ! launchctl bootstrap system /Library/LaunchDaemons/com.sc4tech.brvg-hub.plist; then
  echo "brvg-hub: launchctl bootstrap failed — the daemon is NOT running" >&2
  exit 1
fi

# bootstrap returning 0 means launchd ACCEPTED the job, not that the process survived. A binary that
# starts and immediately exits is accepted and then reaped, so confirm it is actually there. KeepAlive
# would restart it, which is exactly why the naive check races: allow a moment before asking.
sleep 1
if ! launchctl print system/com.sc4tech.brvg-hub >/dev/null 2>&1; then
  echo "brvg-hub: bootstrap succeeded but the job is not loaded — the daemon is NOT running" >&2
  exit 1
fi

# The TRAY AGENT — best-effort, and deliberately NOT fatal. The daemon is the product; the tray is
# a convenience, and a menu-bar icon that failed to appear must never fail the whole install the way
# a dead daemon does. The agent lives in /Library/LaunchAgents, so launchd loads it into every GUI
# session at the NEXT login on its own — this block only makes it appear in the session already open.
#
# It has to be bootstrapped into that user's GUI domain, not the system domain: a menu-bar app draws
# in an Aqua session and runs as the user. `/dev/console` is owned by whoever is logged in at the
# screen; if that is root or the login window (nobody logged in), there is no session to target and
# we simply skip — RunAtLoad covers the next login.
CONSOLE_UID=$(stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "$CONSOLE_UID" -gt 0 ]; then
  launchctl bootout "gui/$CONSOLE_UID/com.sc4tech.brvg-hub-tray" 2>/dev/null || true
  launchctl bootstrap "gui/$CONSOLE_UID" /Library/LaunchAgents/com.sc4tech.brvg-hub-tray.plist 2>/dev/null || true
fi

exit 0
