#!/bin/sh /etc/rc.common
# BRVG phone-home hub-lite — OpenWrt/GL.iNet procd service.
# Install: copy brvg-hub-lite.sh to /usr/bin/brvg-hub-lite (chmod 755), config to /etc/brvg-hub-lite.conf
# (chmod 600), this file to /etc/init.d/brvg-hub-lite (chmod 755), then:
#   /etc/init.d/brvg-hub-lite enable && /etc/init.d/brvg-hub-lite start

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/brvg-hub-lite
    procd_set_param respawn 3600 30 0   # retry forever, 30 s apart, reset counter hourly
    procd_set_param stderr 1            # hub-lite logs go to logread
    procd_close_instance

    # A dedicated uhttpd serves BOTH CGIs on the vessel LAN:
    #   /cgi-bin/report — the relay tier's webhook receiver (HUB-PROXY.md)
    #   /cgi-bin/mgmt   — the management door (hub-lite 0.14.0)
    #
    # ⚠️ NOT GATED ON HUB_LITE_ENABLED any more (2026-08-21). That flag turns on the RELAY TIER, and
    # tying the listener to it meant a hub-lite that merely reported telemetry had no management
    # door at all — so the app fell back to driving the router VENDOR's API, which is the thing the
    # door exists to replace. The two CGIs are independently deny-by-default (the receiver does
    # nothing until webhooks are pointed at it; the management door answers 401 until the box has
    # collected its key), so serving them costs a listener and nothing else.
    #
    # Still conditional on uhttpd and /www/brvg EXISTING: uhttpd is not stock GL.iNet firmware
    # (bench X750), and the hub-lite itself must keep working without either.
    # shellcheck disable=SC1091
    [ -f /etc/brvg-hub-lite.conf ] && . /etc/brvg-hub-lite.conf
    if [ -x /usr/sbin/uhttpd ] && [ -d /www/brvg ]; then
        procd_open_instance hub_lite
        procd_set_param command /usr/sbin/uhttpd -f -h /www/brvg -x /cgi-bin -p "0.0.0.0:${RECEIVER_PORT:-8181}"
        procd_set_param respawn 3600 30 0
        procd_close_instance
    fi
}
