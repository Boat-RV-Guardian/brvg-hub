#!/bin/sh /etc/rc.common
# BRVG phone-home hub-lite — OpenWrt/GL.iNet procd service.
# Install: copy brvg-hub-lite.sh to /usr/bin/brvg-hub-lite (chmod 755), config to /etc/brvg-hub-lite.conf
# (chmod 600), this file to /etc/init.d/brvg-hub-lite (chmod 755), then:
#   /etc/init.d/brvg-hub-lite enable && /etc/init.d/brvg-hub-lite start

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/brvg-hub-lite
    procd_set_param respawn 3600 30 0   # retry forever, 30 s apart, reset counter hourly
    procd_set_param stderr 1            # hub-lite logs go to logread
    procd_close_instance

    # Relay tier (HUB-PROXY.md): a dedicated uhttpd serves the CGI webhook receiver. Only when the
    # config asks for it AND uhttpd exists — the hub-lite itself must keep working without either.
    # shellcheck disable=SC1091
    [ -f /etc/brvg-hub-lite.conf ] && . /etc/brvg-hub-lite.conf
    if [ "${HUB_LITE_ENABLED:-0}" = "1" ] && [ -x /usr/sbin/uhttpd ] && [ -d /www/brvg ]; then
        procd_open_instance hub_lite
        procd_set_param command /usr/sbin/uhttpd -f -h /www/brvg -x /cgi-bin -p "0.0.0.0:${RECEIVER_PORT:-8181}"
        procd_set_param respawn 3600 30 0
        procd_close_instance
    fi
}
