# BRVG phone-home hub-lite — systemd unit for Pi-class hubs.
# Install: copy brvg-hub-lite.sh to /usr/local/bin/brvg-hub-lite (chmod 755), config to
# /etc/brvg-hub-lite.conf (chmod 600), this file to /etc/systemd/system/, then:
#   systemctl enable --now brvg-hub-lite

[Unit]
Description=BRVG phone-home hub-lite (GPS + modem telemetry)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/brvg-hub-lite
Restart=always
RestartSec=30
# Telemetry pusher needs nothing but the serial devices and outbound HTTPS.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
